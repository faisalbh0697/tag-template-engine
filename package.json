{
  "name": "tag-template-engine",
  "version": "3.0.0",
  "private": true,
  "description": "Server-side conversion tag templates for Meta, TikTok, Google Ads, Klaviyo, and Pinterest. Auto-init configs, no terminal needed.",
  "repository": {
    "type": "git",
    "url": "https://github.com/faisalbhxyz/tag-template-engine.git"
  },
  "scripts": {
    "dev": "wrangler dev --port 43181 --ip 127.0.0.1",
    "start": "wrangler dev --port 43181 --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
