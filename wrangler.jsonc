{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tag-template-engine",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }

  // Optional — uncomment after creating resources in the Cloudflare dashboard.
  // kv_namespaces: [{ binding: "CONFIG", id: "your-kv-namespace-id" }]
  //
  // queues: {
  //   producers: [{ binding: "RETRY_QUEUE", queue: "tag-template-retry" }],
  //   consumers: [{ queue: "tag-template-retry", max_batch_size: 10, max_retries: 5 }]
  // }
  //
  // routes: [{ pattern: "tags.example.com/*", zone_name: "example.com" }]
}
